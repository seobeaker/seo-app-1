# Copy to .env and fill in. Never commit .env.

# DataForSEO API credentials: https://app.dataforseo.com/api-access
# (API login is your account email; the API password is shown on that page, not your website password.)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# true = use built-in sample data (no credentials needed, no cost). Set to false for real data.
DATAFORSEO_MOCK=false

# Refuse any new API call once today's spend (UTC) would pass this many USD. 0 = no cap.
DAILY_SPEND_CAP_USD=2.0

# How long cached keyword results are reused before a new search hits the API again.
CACHE_TTL_DAYS=30

# Defaults for the UI
DEFAULT_COUNTRY_ISO=AU
DEFAULT_LANGUAGE_CODE=en

# Price model for the "estimated cost" hint only (check https://dataforseo.com/pricing).
# The real cost of every call is read from the API response and logged.
PRICE_LABS_PER_TASK=0.01
PRICE_LABS_PER_ITEM=0.0001
PRICE_GOOGLE_ADS_VOLUME_PER_TASK=0.075
PRICE_GOOGLE_ADS_KFK_PER_TASK=0.075

# SQLite file (default: ./data/app.db). Docker sets this to /data/app.db.
# DATABASE_PATH=

# ---- Production only (docker-compose.prod.yml) ----
# Your domain, e.g. keywords.example.com (point its DNS A record at the VPS first)
SITE_ADDRESS=
# Basic auth for the site. Create the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# In this file, write every $ in the hash as $$ (docker compose treats $ specially).
BASIC_AUTH_USER=
BASIC_AUTH_HASH=
